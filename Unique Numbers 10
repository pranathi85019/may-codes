import java.util.*;
class Solution{
public static boolean = undig(int n){
   boolean[] seen = new boolean[10];  //0-9
  while(n>0){
   int dig = n%10;
    if(seen[dig]){
      return false;
    }
      seen[dig] = true;
      n=n/10;
    }
    return true;}
  public static void main(String[] args){
    Scanner in=new Scanner(System.in);
    int l = in.nextInt();  //l=20
    int r = in.nextInt();  //r=30
    for(int i=l;i<=r;i++){
     if(undig(i)){
    System.out.print(i + " ");}}}}

   






